[application]

config/name="FunkyCardsArena"
config/description="Un jeu mega funky !"
run/main_scene="res://main.tscn"
boot_splash/image="res://screens/board/ArenaTest.png"
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

Utils="*res://addons/cardengine/core/utils.gd"
CardEngine="*res://addons/cardengine/core/card_engine_instance.gd"
Gameplay="*res://gameplay.gd"
UserStores="*res://user_data/ud_stores.gd"
Network="*res://network/network.gd"
Global="*res://network/global.gd"
Players="*res://network/Players.tscn"
Discord="*res://addons/discord_game_sdk/discord.gd"

[debug]

gdscript/warnings/unused_class_variable=true
gdscript/warnings/unsafe_property_access=true
gdscript/warnings/unsafe_method_access=true
gdscript/warnings/unsafe_cast=true
gdscript/warnings/unsafe_call_argument=true

[display]

window/size/width=1280
window/size/height=720
window/size/test_width=960
window/size/test_height=540
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor]

convert_text_resources_to_binary_on_export=true

[editor_plugins]

enabled=PoolStringArray( "res://addons/cardengine/plugin.cfg", "res://addons/discord_game_sdk/plugin.cfg", "res://addons/project-statistics/plugin.cfg", "res://addons/simple-project-timer/plugin.cfg" )

[global]

icon=false

[gui]

timers/tooltip_delay_sec=0.1

[input]

quentincaffeino_console_toggle={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":true,"meta":false,"command":true,"pressed":false,"scancode":96,"physical_scancode":0,"unicode":0,"echo":false,"script":null)
 ]
}
quentincaffeino_console_autocomplete={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":16777218,"physical_scancode":0,"unicode":0,"echo":false,"script":null)
 ]
}
quentincaffeino_console_history_up={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":16777232,"physical_scancode":0,"unicode":0,"echo":false,"script":null)
 ]
}
quentincaffeino_console_history_down={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":16777234,"physical_scancode":0,"unicode":0,"echo":false,"script":null)
 ]
}

[mono]

project/assembly_name="FunkyCardsArena"

[rendering]

quality/filters/anisotropic_filter_level=16
environment/default_clear_color=Color( 0, 0, 0, 1 )
quality/filters/msaa=3
environment/default_environment="res://default_env.tres"

[statistics]

force_include=PoolStringArray(  )
