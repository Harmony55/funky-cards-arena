[sub_resource type="Shader" id=3]
code = "shader_type canvas_item;
uniform float scroll_speed;
void fragment() {
	vec2 shifteduv = UV;
	shifteduv.x += TIME * -0.02;
	vec4 col = texture(TEXTURE,shifteduv);
	COLOR = col;
}"

